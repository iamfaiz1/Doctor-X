# Relative paths are resolved from the backend directory.
MODEL_PATH=models/densenet121_chexpert.pth
MODEL_DEVICE=auto
MAX_UPLOAD_BYTES=10485760
REQUIRE_MODEL_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: prediction and Grad-CAM continue working without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REPORT_DIRECTORY=generated_reports
