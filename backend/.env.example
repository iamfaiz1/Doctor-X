# Relative paths are resolved from the repository root.
MODEL_PATH=models/densenet121_chexpert.pth
# auto uses CUDA when it is available; otherwise CPU.
MODEL_DEVICE=auto
MAX_UPLOAD_BYTES=10485760
# Keep true for production. Set false only to run API-only development without the model.
REQUIRE_MODEL_ON_STARTUP=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
